DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_prescription
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
# Set COOKIE_SECURE=true and a unique JWT_SECRET (32+ characters) before production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Use COOKIE_SAMESITE=none only with COOKIE_SECURE=true for a cross-site deployment.
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=120
# Cloudinary Settings
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# AI Settings
GOOGLE_API_KEY=your-gemini-api-key
AI_CONFIDENCE_THRESHOLD=0.75
AI_MODEL_NAME=gemini-2.5-flash
AI_REQUEST_TIMEOUT=60
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=10
